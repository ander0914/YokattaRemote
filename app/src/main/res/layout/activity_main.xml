<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_night"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 頂部狀態列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_night"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_disconnected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="好咖機萬能遙控器"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="初始化中..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/RemoteButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:paddingHorizontal="16dp"
                android:text="連線"
                android:textSize="13sp"
                app:backgroundTint="@color/accent_voice"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- 第一排：電源/休眠、喚醒、語音搜尋 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPower"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="⏻ 休眠/電源"
                android:textSize="14sp"
                app:backgroundTint="@color/accent_power"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWake"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="☀ 喚醒螢幕"
                android:textSize="14sp"
                app:backgroundTint="@color/surface_button"
                app:strokeColor="@color/accent_wake" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoice"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🎤 語音"
                android:textSize="14sp"
                app:backgroundTint="@color/accent_voice"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- 第二排：亮度 +/-、靜音、音量 +/- -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_night"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 亮度控制 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightUp"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="☀ 亮度 ＋" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightDown"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="☀ 亮度 －" />
            </LinearLayout>

            <!-- 中央靜音鍵 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/RemoteRoundButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="12dp"
                android:text="🔇
靜音"
                android:textSize="13sp" />

            <!-- 音量控制 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolUp"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🔊 音量 ＋" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolDown"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="🔉 音量 －" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第三排：圓形十字方向鍵盤 (D-Pad) -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dpad_ring"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUp"
                style="@style/RemoteRoundButton"
                android:layout_width="72dp"
                android:layout_height="62dp"
                android:layout_gravity="top|center_horizontal"
                android:text="▲"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDown"
                style="@style/RemoteRoundButton"
                android:layout_width="72dp"
                android:layout_height="62dp"
                android:layout_gravity="bottom|center_horizontal"
                android:text="▼"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeft"
                style="@style/RemoteRoundButton"
                android:layout_width="62dp"
                android:layout_height="72dp"
                android:layout_gravity="start|center_vertical"
                android:text="◀"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRight"
                style="@style/RemoteRoundButton"
                android:layout_width="62dp"
                android:layout_height="72dp"
                android:layout_gravity="end|center_vertical"
                android:text="▶"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOk"
                style="@style/RemoteRoundButton"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center"
                android:text="OK"
                android:textSize="18sp"
                app:backgroundTint="@color/accent_ok"
                app:strokeWidth="0dp" />
        </FrameLayout>

        <!-- 第四排：Android 系統導覽列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="↩ 返回" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="⌂ 首頁" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecents"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="▢ 最近" />
        </LinearLayout>

        <!-- 第五排：媒體播放與 YouTube 快進/倒退 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_night"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="⏮ 上一首"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.2"
                    android:text="⏯ 播放/暫停"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="下一首 ⏭"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- YouTube 專屬區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="YouTube 快捷控制"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYtRewind"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="⏪ 倒退 10 秒"
                    app:strokeColor="@color/accent_youtube" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYtForward"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="快進 10 秒 ⏩"
                    app:strokeColor="@color/accent_youtube" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
