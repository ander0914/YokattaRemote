<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_night"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 頂部狀態列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_night"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_disconnected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="好咖機萬能遙控器"
                    android:textColor="@color/text_primary"
                    android:textSize="15dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="初始化中..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/RemoteButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="連線"
                android:textSize="12dp"
                app:backgroundTint="@color/accent_voice"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- 第一排：電源/休眠、喚醒、語音搜尋 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPower"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="🔴 電源/休眠"
                app:backgroundTint="@color/accent_power"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWake"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="☀ 喚醒螢幕"
                app:backgroundTint="@color/surface_button"
                app:strokeColor="@color/accent_wake" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoice"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🎤 語音"
                app:backgroundTint="@color/accent_voice"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- 第二排：亮度 +/-、靜音、音量 +/- -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_night"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightUp"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="☀ 亮度 ＋" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrightDown"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:minHeight="44dp"
                    android:text="☀ 亮度 －" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                style="@style/RemoteRoundButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:autoSizeMaxTextSize="12dp"
                android:autoSizeMinTextSize="9dp"
                android:maxLines="2"
                android:text="🔇
靜音"
                android:textSize="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolUp"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="🔊 音量 ＋" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolDown"
                    style="@style/RemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:minHeight="44dp"
                    android:text="🔉 音量 －" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中央操作區切換分頁：滑鼠觸控板 / 方向鍵盤 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabTouchpad"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minHeight="38dp"
                android:text="🖱 滑鼠觸控板"
                android:textSize="12dp"
                app:backgroundTint="@color/accent_voice"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabDpad"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:minHeight="38dp"
                android:text="✚ 方向鍵盤"
                android:textSize="12dp" />
        </LinearLayout>

        <!-- 區塊 A：虛擬滑鼠觸控板（預設顯示） -->
        <LinearLayout
            android:id="@+id/containerTouchpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/touchpadArea"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:background="@drawable/bg_touchpad_surface"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="滑鼠觸控區
單指滑動移動游標 · 輕點一下＝點擊"
                    android:textColor="@color/text_secondary"
                    android:textSize="12dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMouseLeftClick"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1.3"
                    android:minHeight="44dp"
                    android:text="🖱 左鍵點擊 (OK)"
                    app:backgroundTint="@color/accent_ok"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSensitivity"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="靈敏度：中" />
            </LinearLayout>
        </LinearLayout>

        <!-- 區塊 B：圓形十字方向鍵盤 (D-Pad) -->
        <LinearLayout
            android:id="@+id/containerDpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:background="@drawable/bg_dpad_ring"
                android:padding="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUp"
                    style="@style/RemoteRoundButton"
                    android:layout_width="64dp"
                    android:layout_height="54dp"
                    android:layout_gravity="top|center_horizontal"
                    android:autoSizeMaxTextSize="18dp"
                    android:text="▲"
                    android:textSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDown"
                    style="@style/RemoteRoundButton"
                    android:layout_width="64dp"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:autoSizeMaxTextSize="18dp"
                    android:text="▼"
                    android:textSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeft"
                    style="@style/RemoteRoundButton"
                    android:layout_width="54dp"
                    android:layout_height="64dp"
                    android:layout_gravity="start|center_vertical"
                    android:autoSizeMaxTextSize="18dp"
                    android:text="◀"
                    android:textSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRight"
                    style="@style/RemoteRoundButton"
                    android:layout_width="54dp"
                    android:layout_height="64dp"
                    android:layout_gravity="end|center_vertical"
                    android:autoSizeMaxTextSize="18dp"
                    android:text="▶"
                    android:textSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOk"
                    style="@style/RemoteRoundButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:autoSizeMaxTextSize="18dp"
                    android:text="OK"
                    android:textSize="18dp"
                    app:backgroundTint="@color/accent_ok"
                    app:strokeWidth="0dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_mode"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="OK 模式：Enter 確認 ▾"
                android:textColor="@color/text_secondary"
                android:textSize="11dp" />
        </LinearLayout>

        <!-- 第四排：Android 系統導覽列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="↩ 返回" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="⌂ 首頁" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecents"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="▢ 最近" />
        </LinearLayout>

        <!-- 第五排：媒體播放與倒退/快進 10 秒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_night"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:text="⏮ 上一首" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.2"
                    android:minHeight="46dp"
                    android:text="⏯ 播放/暫停" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:text="下一首 ⏭" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYtRewind"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="⏪ 倒退 10 秒"
                    app:strokeColor="@color/accent_youtube" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYtForward"
                    style="@style/RemoteButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="快進 10 秒 ⏩"
                    app:strokeColor="@color/accent_youtube" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
