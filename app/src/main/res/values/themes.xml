<resources>
    <style name="Theme.YokattaRemote" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_night</item>
        <item name="android:statusBarColor">@color/bg_night</item>
        <item name="android:navigationBarColor">@color/bg_night</item>
        <item name="colorPrimary">@color/accent_voice</item>
        <item name="colorSurface">@color/surface_card</item>
    </style>

    <style name="RemoteButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface_button</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">13dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9dp</item>
        <item name="android:autoSizeMaxTextSize">13dp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="RemoteRoundButton" parent="RemoteButton">
        <item name="cornerRadius">999dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>
</resources>
